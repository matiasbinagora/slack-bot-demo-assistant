{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orca",
  "subagent_depth": 1,
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "lsp": false,
  "mcp": {
    "local-repo-trello": {
      "type": "local",
      "enabled": true,
      "cwd": ".",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run",
        "--servers",
        "trello-local",
        "--secrets",
        ".env.mcp"
      ]
    },
    "local-repo-github": {
      "type": "local",
      "enabled": true,
      "cwd": ".",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run",
        "--servers",
        "github-official",
        "--secrets",
        ".env.mcp"
      ]
    },
    "paradigm-memory": {
      "enabled": false
    },
    "codebase-memory": {
      "type": "local",
      "enabled": true,
      "command": [
        "/Users/matiasbinagora/.local/share/opencode/tools/codebase-memory-mcp/v0.9.0/codebase-memory-mcp"
      ],
      "cwd": ".",
      "environment": {
        "CBM_ALLOWED_ROOT": ".",
        "CBM_CACHE_DIR": ".codebase-memory/cache",
        "CBM_LOG_LEVEL": "info"
      },
      "timeout": 120000
    },
    "graphify-v0.9.32": {
      "type": "local",
      "enabled": true,
      "cwd": ".",
      "command": [
        "/Users/matiasbinagora/.local/share/opencode/tools/graphify/v0.9.32/.venv/bin/python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ],
      "environment": {
        "GRAPHIFY_QUERY_LOG_DISABLE": "1"
      },
      "timeout": 30000
    }
  },
  "instructions": [
    "AGENTS.md",
    "README.md"
  ]
}
