{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "lsp": {
    "governance": {
      "command": [
        "./node_modules/.bin/ts-node",
        "--prefer-ts-exts",
        "bin/governance-lsp-server.ts"
      ],
      "extensions": [
        ".md",
        ".ts",
        ".json",
        ".yaml",
        ".yml"
      ]
    }
  },
  "mcp": {
   "local-repo-trello": {
      "type": "local",
      "enabled": true,
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run",
        "--servers",
        "trello-local",
        "--secrets",
        ".env.mcp"
      ]
    },
    "local-repo-github": {
      "type": "local",
      "enabled": true,
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run",
        "--servers",
        "github-official",
        "--secrets",
        ".env.mcp"
      ]
    },
    "paradigm-memory": {
      "type": "local",
      "enabled": true,
      "command": [
        "/Users/matiasbinagora/.local/share/opencode/tools/paradigm-memory/v0.1.4/bin/paradigm-memory-mcp"
      ],
      "environment": {
        "PARADIGM_MEMORY_DIR": "/Users/matiasbinagora/.local/share/opencode/projects/aws-elemental-inference/paradigm-memory",
        "PARADIGM_DISABLE_UPDATE_CHECK": "1",
        "PARADIGM_MEMORY_EMBEDDINGS": "keyword"
      },
      "timeout": 30000
    },
    "codebase-memory": {
      "type": "local",
      "enabled": true,
      "command": [
        "/Users/matiasbinagora/.local/share/opencode/tools/codebase-memory-mcp/v0.9.0/codebase-memory-mcp"
      ],
      "cwd": "/Users/matiasbinagora/Projects/aws-elemental-inference",
      "environment": {
        "CBM_ALLOWED_ROOT": "/Users/matiasbinagora/Projects/aws-elemental-inference",
        "CBM_CACHE_DIR": "/Users/matiasbinagora/.cache/codebase-memory-mcp/aws-elemental-inference/main",
        "CBM_LOG_LEVEL": "info"
      },
      "timeout": 120000
    },
    "graphify-v0.9.32": {
      "type": "local",
      "enabled": false,
      "command": [
        "/Users/matiasbinagora/.local/share/opencode/tools/graphify/v0.9.32/.venv/bin/python",
        "-m",
        "graphify.serve",
        "/Users/matiasbinagora/.cache/graphify/aws-elemental-inference/main/graphify-out/graph.json"
      ],
      "environment": {
        "GRAPHIFY_QUERY_LOG_DISABLE": "1"
      },
      "timeout": 30000
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}
